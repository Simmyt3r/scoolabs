{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scoolabs",
  "version": "0.2.0",
  "identifier": "ng.silabs.scoolabs",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Scoolabs | Offline Science Laboratory",
        "width": 1280,
        "height": 820,
        "minWidth": 920,
        "minHeight": 640,
        "backgroundColor": "#f5f8fa"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    },
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
