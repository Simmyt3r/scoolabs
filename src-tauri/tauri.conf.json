{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scoolabs",
  "version": "0.14.0",
  "identifier": "ng.silabs.scoolabs",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Scoolabs | Offline Virtual Science Laboratory",
        "width": 1280,
        "height": 820,
        "minWidth": 920,
        "minHeight": 640,
        "backgroundColor": "#f5faf9"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    },
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "publisher": "Simeon's Laboratories and Co Technologies Ltd",
    "category": "Education",
    "copyright": "Copyright 2026 Simeon's Laboratories and Co Technologies Ltd",
    "shortDescription": "Offline interactive science laboratories for schools",
    "resources": {
      "resources/offline-assets/": "offline-assets/"
    }
  }
}
